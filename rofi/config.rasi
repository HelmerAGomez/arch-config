/**
 * Simplified Self-Contained Rofi Config 
 * Inspired by Sameemul Haque's Mocha Theme
 **/

configuration {
    modi:                       "drun,run";
    show-icons:                 true;
    display-drun:               "";
    drun-display-format:        "{name}";
    font:                       "JetBrainsMono Nerd Font 10";
}

* {
    bg:          #1e1e2e;
    fg:          #cdd6f4;
    accent:      #89b4fa;
    urgent:      #f38ba8;
    selected:    #313244;
    border-col:  #89b4fa;
    
    background-color:   transparent;
    text-color:         @fg;
}

window {
    transparency:       "real";
    location:           center;
    anchor:             center;
    fullscreen:         false;
    width:              400px;
    x-offset:           0px;
    y-offset:           0px;

    enabled:            true;
    border:             2px;
    border-radius:      12px;
    border-color:       @border-col;
    background-color:   @bg;
    cursor:             "default";
}

mainbox {
    enabled:            true;
    spacing:            10px;
    padding:            20px;
    children:           [ "inputbar", "listview" ];
}

inputbar {
    enabled:            true;
    spacing:            10px;
    padding:            5px;
    background-color:   @selected;
    text-color:         @fg;
    border-radius:      8px;
    children:           [ "prompt", "entry" ];
}

prompt {
    enabled:            true;
    background-color:   inherit;
    text-color:         @accent;
}

entry {
    enabled:            true;
    background-color:   inherit;
    text-color:         inherit;
    cursor:             text;
    placeholder:        "Search...";
    placeholder-color:  inherit;
}

listview {
    enabled:            true;
    columns:            1;
    lines:              8;
    cycle:              true;
    dynamic:            true;
    scrollbar:          false;
    layout:             vertical;
    reverse:            false;
    fixed-height:       true;
    fixed-columns:      true;
    spacing:            5px;
}

element {
    enabled:            true;
    spacing:            10px;
    padding:            8px;
    border-radius:      8px;
    cursor:             pointer;
}

element selected.normal {
    background-color:   @accent;
    text-color:         @bg;
}

element-icon {
    size:               24px;
    cursor:             inherit;
}

element-text {
    vertical-align:     0.5;
    horizontal-align:   0.0;
    cursor:             inherit;
    text-color:         inherit;
}
